#
# Project formatting rules: Allman braces, 4-space indent, max 120 columns.
# Run: clang-format -i <files>

BasedOnStyle: LLVM

# Braces on their own line (Allman style); an empty function body stays on one line: {}
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: true
  AfterClass: true
  AfterControlStatement: Always
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  AfterUnion: true
  AfterExternBlock: true
  BeforeCatch: true
  BeforeElse: true
  BeforeLambdaBody: false
  BeforeWhile: false
  IndentBraces: false
  SplitEmptyFunction: false
  SplitEmptyRecord: true
  SplitEmptyNamespace: true
IndentWidth: 4
TabWidth: 4
UseTab: Never

# Maximum line length
ColumnLimit: 120

# `public:` / `private:` at the same column as `class`
AccessModifierOffset: -4

# Namespace bodies are not indented; closing brace gets `}  // namespace pictorio::name`
NamespaceIndentation: None
FixNamespaceComments: true
SpacesBeforeTrailingComments: 2

# Readability: no one-line functions (except empty ones), ifs or loops
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never

PointerAlignment: Left

# Empty line between function and class definitions. (The wider rule "an empty line after every
# closing brace" cannot be expressed in clang-format; see CONTRIBUTING.md.)
SeparateDefinitionBlocks: Always

# If a call or declaration does not fit on one line, put each argument / parameter on its own line
BinPackArguments: false
BinPackParameters: OnePerLine

# Constructor initializers: one per line, comma first
BreakConstructorInitializers: BeforeComma
PackConstructorInitializers: Never

# Includes are grouped by hand, one block per group, in this order: own header, standard library,
# external libraries, common helpers, local files. clang-format only sorts inside a block.
IncludeBlocks: Preserve
SortIncludes: CaseSensitive
